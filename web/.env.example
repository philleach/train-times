# Copy to .env and fill in. The web client only needs to read the MQTT broker
# the bridge already publishes to (same host/creds the Pico uses).
MQTT_HOST = "your-broker-host"
MQTT_PORT = 8883
MQTT_TLS = 1          # 1 for a cloud/Funnel broker over TLS; 0 for a local plaintext Mosquitto
MQTT_USER = "train-times-client"
MQTT_PASSWORD = "your-mqtt-password"

# Where the web app listens. Behind Tailscale Funnel on the box, bind loopback
# and let Funnel terminate TLS / expose it publicly.
WEB_HOST = "0.0.0.0"
WEB_PORT = 8000
