# Copy to .env and fill in values. Never commit .env.
KAFKA_API_KEY=your-confluent-api-key
KAFKA_API_SECRET=your-confluent-api-secret
# KAFKA_TOPIC=darwin-pushport-json  # default; override if your topic name differs

MQTT_HOST=abc123.s2.eu.hivemq.cloud
MQTT_USER=your-hivemq-username
MQTT_PASSWORD=your-hivemq-password
# MQTT_PORT=8883  # default; only override if needed
# MQTT_TLS=1      # default; set 0 for a local plaintext Mosquitto on loopback
#
# Local Mosquitto + Tailscale Funnel setup (publish to loopback, no cloud broker):
#   MQTT_HOST=127.0.0.1
#   MQTT_PORT=1883
#   MQTT_TLS=0
#   MQTT_USER / MQTT_PASSWORD = your local mosquitto credentials

# OpenLDBSVWS (Live Arrival & Departure Boards - Staff Version) REST API, for
# coach formation lookups when Darwin lacks them. Optional. Get the key (x-apikey)
# from the Rail Data Marketplace product subscription. The base URL defaults to
# the RDM gateway for this product, so normally only the key is needed.
# LDBSV_KEY=your-rail-data-marketplace-api-key
# LDBSV_BASE_URL=https://api1.raildata.org.uk/<product-slug>/LDBSVWS  # override only if the gateway path differs
